{
  "manifest_version": 2,
  "gecko_id": "bside@tsuni.dev",
  "gecko_min_version": "140.0",
  "gecko_android_min_version": "142.0",
  "data_collection_permissions": {
    "required": [
      "authenticationInfo",
      "browsingActivity",
      "financialAndPaymentInfo",
      "healthInfo",
      "locationInfo",
      "personalCommunications",
      "personallyIdentifyingInfo",
      "searchTerms",
      "websiteActivity",
      "websiteContent"
    ]
  },
  "background_persistent": true,
  "permissions": [
    "<all_urls>",
    "alarms",
    "cookies",
    "https://ai.todoist.net/*",
    "https://api.openai.com/*",
    "https://auth.openai.com/*",
    "https://mcp.notion.com/*",
    "https://todoist.com/*",
    "identity",
    "menus",
    "notifications",
    "search",
    "sessions",
    "storage",
    "tabHide",
    "webRequest",
    "webRequestBlocking"
  ],
  "optional_permissions": [],
  "content_security_policy": [
    "default-src 'self'",
    "script-src 'self'",
    "object-src 'none'",
    "connect-src 'self' https://api.openai.com https://auth.openai.com https://www.youtube.com https://mcp.notion.com https://ai.todoist.net https://todoist.com",
    "img-src 'self' data:",
    "style-src 'self' 'unsafe-inline'"
  ],
  "content_scripts_matches": [
    [
      "http://*/*",
      "https://*/*"
    ]
  ],
  "content_scripts_frames": [
    {
      "all_frames": true,
      "match_about_blank": false
    }
  ],
  "web_accessible_resources": []
}
